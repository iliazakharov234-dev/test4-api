          "path": ["api", "nonexistent"]
        },
        "description": "Несуществующий эндпоинт. Ожидание: 404 (Laravel RouteNotFoundException → HTTP 404)."
      }
    },
    {
      "name": "11. POST /api/logout — с токеном",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Message is Logged out', function () {",
              "    pm.expect(pm.response.json().message).to.eql('Logged out');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "logout"]
        },
        "description": "Выход: удаляет текущий токен. Заголовок Authorization: Bearer {{auth_token}} (токен берётся из ответа запроса 4 — POST /api/login). Без токена или с невалидным — ожидание 401. Ожидание: 200 {\"message\":\"Logged out\"}. ВНИМАНИЕ: после выполнения этого запроса токен перестаёт действовать — запросы 8-9 с ним вернут 401, нужно логиниться заново."
      }
    }
  ]
}
