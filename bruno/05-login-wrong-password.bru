meta {
  name: 5. POST /api/login — неверный пароль
  type: http
  seq: 5
}

docs {
  Неверный пароль при верном email login@test.ru. Ожидание: 401 {"message":"Invalid credentials"}.
}

post {
  url: {{base_url}}/api/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "login@test.ru",
    "password": "WrongPass1"
  }
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });

  test("message is Invalid credentials", function() {
    expect(res.body.message).to.equal("Invalid credentials");
  });
}
